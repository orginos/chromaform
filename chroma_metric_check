chroma_metric_check () {
python3 - "$@" <<'PY'
import sys, math, xml.etree.ElementTree as ET
if len(sys.argv) != 5:
    print("usage: chroma_metric_check CONTROL CANDIDATE METRIC LOG")
    sys.exit(2)

control, cand, metric, logf = sys.argv[1:5]
ct = ET.parse(control); cd = ET.parse(cand); mt = ET.parse(metric)

def pmap(root, xp):
    parts = [p for p in xp.strip().lstrip('/').split('/') if p]
    if parts and parts[0] == root: parts = parts[1:]
    return "./" + "/".join(parts)

ok = True
lines = []
for a in mt.findall(".//assertion"):
    xp = a.attrib["xpath"]
    typ = a.attrib.get("type","")
    cmp = a.attrib.get("comparison","")
    tol = a.attrib.get("tolerance","ignore")
    p = pmap(ct.getroot().tag, xp)
    c = ct.find(p); d = cd.find(p)
    if c is None or d is None:
        lines.append(f"MISSING {xp}"); ok = False; continue
    cs = (c.text or "").strip(); ds = (d.text or "").strip()

    if cmp == "equality" or typ == "string":
        passed = (cs == ds)
        lines.append(f"EQ {xp} {'PASS' if passed else 'FAIL'}")
        ok &= passed
        continue

    if tol == "ignore":
        lines.append(f"SKIP {xp}")
        continue

    cv = float(cs); dv = float(ds); tv = float(tol)
    if cmp in ("relative","relative_comparison"):
        rel = abs(dv-cv)/max(abs(cv),1e-300)
        passed = rel <= tv
        lines.append(f"REL {xp} {'PASS' if passed else 'FAIL'} rel={rel} tol={tv}")
    elif cmp == "absolute":
        ab = abs(dv-cv)
        passed = ab <= tv
        lines.append(f"ABS {xp} {'PASS' if passed else 'FAIL'} abs={ab} tol={tv}")
    else:
        passed = False
        lines.append(f"UNKNOWN {xp} comparison={cmp}")
    ok &= passed

lines.append("OVERALL " + ("PASS" if ok else "FAIL"))
open(logf, "w").write("\n".join(lines) + "\n")
print("\n".join(lines))
sys.exit(0 if ok else 1)
PY
}
